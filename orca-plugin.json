{
  "manifestVersion": 2,
  "id": "task-notes",
  "name": "Task notes",
  "version": "0.1.0",
  "description": "A sidebar panel and the worker that answers it.",
  "engines": {
    "orca": ">=1.4.246"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "task-notes",
        "title": "Task notes",
        "icon": "blocks",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "storage:own"
    }
  ]
}
